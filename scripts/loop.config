# Loop config — mirrors TDD_PLAN §2 + §8. Shell-sourceable.
# THIS is the only per-project file. The rest of scripts/ is the frozen generic harness
# (copied verbatim by install-harness.sh). Fill the <...> placeholders from TDD_PLAN.
STACK=pytest                          # which scripts/adapters/<STACK>.sh (gradle|maven|npm|pytest|go|cargo)

# Loop artifacts dir — ticket-scoped so filenames stay invariant + a 2nd loop can't clobber.
# Key to the WORK ITEM (ticket), not the branch (branch = <type>/<TICKET>-<kebab>, drags a / into the path).
SPEC_DIR='specs/HAS-school-menu'      # e.g. specs/TT-123-payments → holds TDD_PLAN/LOOP_STATE/LOOP_CLAUDE/ESCALATION (upstream spec → docs/plans/)

# e2e acceptance tags: `@<ticket>-<milestone>` (true, default) or bare `@<milestone>` (false).
# The default guards the ONE-TICKET-PER-LOOP repo, where every loop names its single milestone M1 and
# a bare @m1 matches the PREVIOUS ticket's acceptance test — verified once as `e2e(@m1) PASS` for a
# milestone that had no acceptance test at all.
# Set false for an EPIC-PER-LOOP repo, where one ticket owns many milestones (m0..m7, c0..c5): every
# bare tag is then already globally unique, no foreign loop exists to collide with, and prefixing
# would mean retagging every shipped spec for no safety gain.
E2E_TAG_TICKET_PREFIX=false

# Role write-scopes (newline-delimited globs; bash-3.2 multi-line var)
MAIN_SCOPE='custom_components/school_menu/*'
TEST_SCOPE='tests/*'
REVIEW_SCOPE='review-results/*'          # review-loop writes review-results/<branch>_issues.md; driver curates root issues.md (DRIVER_SCOPE)
DRIVER_SCOPE='scripts/*
issues.md
pyproject.toml
requirements-test.txt
setup.cfg
.github/*
.gitignore
hacs.json
specs/*
README.md'
BOOTSTRAP_SCOPE="$DRIVER_SCOPE
custom_components/*
tests/*"

# Skill ids — gradle/maven (Java) defaults; STACK≠gradle → swap per SKILL.md "Language profiles"
REVIEWER_SKILL='python-services:review-loop'          # pytest → python-services:review-loop | npm → typescript-services:review-loop (go/cargo → '' = built-in /code-review)
SCAFFOLD_SKILL=''             # pytest → python-services:scaffold | npm → typescript-services:scaffold (go/cargo → '' = bootstrap writes M0)
PROD_SKILL='python-services:production-code-recipe'   # pytest → python-services:… | npm → typescript-services:production-code-recipe
TEST_SKILL='python-services:test-code-recipe'         # pytest → python-services:… | npm → typescript-services:test-code-recipe

# Progress sync (per-milestone; PR open + merge). README = sync-progress.sh; Jira/Notion = driver MCP steps (SKILL "Progress Sync").
SYNC_JIRA=false                        # progress comment on the milestone Story
SYNC_README=true                      # managed README block (sync-progress.sh)
SYNC_NOTION=false                      # Milestone Progress section on the service's Notion page
README_PATH='./README.md'
NOTION_PARENT_ID='382f4ac3ec9f8111b263e340468452cb'   # Product-Service-Documentation (constant)
SERVICE_NAME='school_menu'              # package.json:name | pyproject | pom:<artifactId> | repo folder

# Deliverables Documentation (TT-3667; SKILL "Deliverables Documentation"). Loop Plan/ADRs/Issue doc → subpages of the TDD Notion page; open issues → Jira Story/Bug under <TICKET> Epic.
SYNC_DELIVERABLES=false                 # publish deliverables as subpages of TDD_DOC_ID + file Jira for open issues
TDD_DOC_ID=''                         # Notion page id of the TDD being implemented (subpage parent); unset → skip

# Model profile — SSOT: config/kitchen.env (KITCHEN_MODEL_*). Inherit via env;
# TDD_PLAN §8 models: wins per-plan (driver writes literal values here instead).
# Agent-tool overrides per role spawn. ids: fable, opus, sonnet, haiku.
MODEL_DRIVER="${KITCHEN_MODEL_DRIVER:-opus}"        # session model; driver surfaces mismatch, continues
MODEL_TEST_AUTHOR="${KITCHEN_MODEL_TEST_AUTHOR:-sonnet}"   # RED step is specified by TDD_PLAN §5; low-novelty
MODEL_IMPLEMENTER="${KITCHEN_MODEL_IMPLEMENTER:-opus}"     # floor; milestone_model() raises/lowers per Mn
MODEL_SCAFFOLD="${KITCHEN_MODEL_SCAFFOLD:-sonnet}"         # M0 layout generation via SCAFFOLD_SKILL
MODEL_JIRA_OPS="${KITCHEN_MODEL_JIRA_OPS:-haiku}"          # loop-driven ticket reads/transitions
MODEL_REVIEWER="${KITCHEN_MODEL_REVIEWER:-opus}"    # never downgrade: a missed blocker costs more than the tier
# The ROUTINE tier for the reviewer (harness 1.8.6): a milestone NOT in CORRECTNESS_CRITICAL reviews
# at this tier on every round; a correctness-critical one keeps MODEL_REVIEWER and the mutation
# escalation below raises it. Measured (TT-4348 M9 §3.1): three sonnet rounds, $8.95, found the two
# production defects in round 1, against $37.02 for four opus rounds on M8. EMPTY disables it and every
# milestone reviews at MODEL_REVIEWER, the pre-1.8.6 behaviour.
MODEL_REVIEWER_ROUTINE="${KITCHEN_MODEL_REVIEWER_ROUTINE:-sonnet}"
# Follow-up review rounds only (round >= 2), and never on a correctness_critical milestone. Round 1
# reads the whole milestone; later rounds read the diff since the last reviewer row, which is a
# fraction of it — measured: rounds 5-8 of one milestone produced one major and nine minors between
# them at the same $2.70-$3.70 a round as round 1. EMPTY disables it and every round stays on
# MODEL_REVIEWER, which is what a loop that has been burned by a missed finding should set.
MODEL_REVIEWER_DELTA="${KITCHEN_MODEL_REVIEWER_DELTA:-sonnet}"
# The VERIFIER (harness 1.8.0): review rounds >= 2 spawn ONE verifier instead of a full fan-out when
# the code diff since the last full round is under REVIEW_FULL_ROUND_DIFF_LINES. It re-proves the OPEN
# findings by id, by execution, and raises nothing new — so it reads a handful of commits, not the
# milestone, and the delta tier is the right price for that. Escalates with the reviewer on a
# correctness_critical milestone (the verifier is the last gate there too); never used on round 1.
MODEL_VERIFIER="${KITCHEN_MODEL_VERIFIER:-sonnet}"
# 1 spawns the read-only escalation agent on a breaker trip (the pre-2026-09 behaviour). 0 — the
# default — has the DRIVER write the recovery digest from ESCALATION.md, LOOP_STATE.md and the ledger,
# which is where its diagnosis came from anyway: seven such spawns cost $6.96 in one milestone, 12% of
# it, to restate evidence already on disk beside the file they wrote.
ESCALATION_AGENT=0
MODEL_SEARCH="${KITCHEN_MODEL_SEARCH:-haiku}"       # read-only exploration/fan-out agents

# ── escalation tiers ────────────────────────────────────────────────────────
# The safety valve that makes the cheaper defaults above safe. Two situations get the strongest tier
# mechanically, because in both of them a cheaper agent has already failed BY DEFINITION:
#
#   MUTATION — a milestone carrying a mutation-score gate (TDD_PLAN §8 `correctness_critical`).
#              Applies to the implementer AND the reviewer: the implementer because the work is the
#              kind whose defects a test suite does not notice, the reviewer because it is the last
#              gate before that work lands.
#   BREAKER  — a circuit-breaker trip. The loop has already stopped; the one agent that runs next is
#              reading a failure that a cheaper tier produced, so it is the last place to save money.
#
# ESCALATION MAY ONLY RAISE. loop-driver.sh ranks ids (haiku < sonnet < opus < fable) and takes the
# HIGHER of the role's tier and the escalation tier, so setting either below a role's normal model is
# inert rather than a silent downgrade of a gate. An unrecognised id ranks lowest and therefore
# changes nothing — the safe direction for a typo.
MODEL_ESCALATION_MUTATION="${KITCHEN_MODEL_ESCALATION_MUTATION:-opus}"
MODEL_ESCALATION_BREAKER="${KITCHEN_MODEL_ESCALATION_BREAKER:-fable}"

# TDD_PLAN §8 `correctness_critical:` — the mutation-gated milestones, space- or newline-separated.
# This is the MARKER the escalation above reads. The plan recipe already emits the list; until now
# only `milestone_model()` consumed it, and only for the implementer.
#
# EMPTY is a real answer, not a missing one: a plan whose milestones carry no mutation gate escalates
# nothing, and every spawn stays on its configured tier.
CORRECTNESS_CRITICAL='M1 M2 M3'               # e.g. 'M3 M5'

# Build-tool perf args — the adapter supplies these defaults; set them here to override per project.
# --configuration-cache is rejected by some gradle plugins: gradlew_run retries once without perf args
# when the failure log mentions a cache, but narrowing to '--build-cache' here skips that wasted run.
GRADLE_PERF_ARGS="${GRADLE_PERF_ARGS:---build-cache --configuration-cache --parallel}"
MAVEN_PERF_ARGS="${MAVEN_PERF_ARGS:--T1C}"          # drop if the build is not parallel-safe
# Testcontainers reuse: keeps containers alive between integration gates. Needs BOTH this AND
# testcontainers.reuse.enable=true in ~/.testcontainers.properties AND .withReuse(true) in test code.
# NEVER true in CI — reused containers outlive the run by design.
TESTCONTAINERS_REUSE_ENABLE="${TESTCONTAINERS_REUSE_ENABLE:-true}"

# Breakers (R-rules)
CHURN_LOC=400; CHURN_FILES=15; STALL_ITERATIONS=3; REPEAT_FAILURE_LIMIT=3
# A `loop-driver.sh steer` longer than this is REFUSED, never truncated (1.8.7, M10 §2.3): the 300-char
# cut of 1.8.6 ended a steer mid-word and the role spent an invocation proving it unreadable. One
# finding, one line; a longer text belongs in the plan, with the steer naming its path.
STEER_MAX_CHARS=1000
# Every breaker carries a GRADE (loop-iteration.sh / loop-driver.sh `breaker_grade`). HARD stops the
# run: scope (R5, R6), spend (R13, RI, RI-ABS), and nothing-left-to-dispatch (RU, RD, RW). SOFT warns
# and continues once; the SAME signature a second time is a hard stop unless the driver acked that
# signature as false, which suppresses it for the milestone. Measured reason: one milestone tripped 38
# times, 23 of them false, and every trip was a human stop. `hard` here restores the old contract.
# R13-LANDED (loop-driver.sh only: a hot invocation that landed its commit and passed) is SOFT.
BREAKER_GRADES=
# RC — a gate FAILING on one cause for this many CONSECUTIVE iterations trips (soft, so it warns once
# and stops on the next). Keyed on FAIL, never PENDING. Measured: one coverage cause repeated for 21
# iterations and was read as normal every time.
REPEAT_CAUSE_LIMIT=3
# 1 (default) lets the driver commit the LOOP'S OWN artifacts — issues.md, review-results/*, and the
# spec dir's journal, ledger and escalation files — as `chore(loop): …` before a role runs and after
# every review round. Nothing else is ever swept up: a dirty scripts/ or build file refuses the spawn
# and names the path. 0 refuses on the loop artifacts too. Either way a role is never audited for the
# driver's files — measured: 4 of 6 R6 trips in one milestone blamed a role for a tree the driver
# left dirty, and "consolidate, commit, then spawn" was a rule in two learnings files.
DRIVER_AUTOCOMMIT=1
# R8's budgets are PER ROLE. Both functions are OPTIONAL — delete them and the flat numbers above
# apply to every role, exactly as before.
#
# LINE budget. 400 is the IMPLEMENTER's, and measured data says it is the right number: over one
# milestone's 54 commits, scored in executable lines, every GREEN commit came in under it while six
# RED ones ran 533–1501. That is not a test-author leaping ahead — a RED module's size is set by the
# step it specifies, and R8 exists to catch an IMPLEMENTER writing more than the step it was handed.
# One number for both roles means the breaker can only be loose enough to ignore the implementer or
# tight enough to fire on every RED step; the loop that had one paid four adjudications for it.
# `driver` shares the test-author's budget because the new churn base spans everything committed
# since the last JOURNALLED iteration, and driver chores are mostly not journalled at all — so a
# driver entry absorbs whatever was committed beside it. A role with no case falls back to CHURN_LOC.
churn_budget(){ case "$1" in test-author|driver) echo 1200;; *) echo "$CHURN_LOC";; esac; }

# R12 prose budget — comment + docstring lines per iteration, Python only (the adapter scores every
# other language as 0 prose). UNSET = OFF; set DOC_LOC to arm it. Rationale goes to docs/rfcs,
# docs/adr, LOOP_HISTORY.md or the commit message, so a role needing more than this is writing in the
# wrong file. Suggested first value: 40 — the driver then gets 120.
# The driver's budget is a MULTIPLE of DOC_LOC, not a constant: a constant inverts the moment DOC_LOC
# is raised past it (DOC_LOC=400 would have budgeted the implementer 400 and the driver 120), and the
# per-role arms of churn_budget/churn_files_budget are always the LOOSER number, never the tighter.
DOC_LOC=0
doc_budget(){ case "$1" in driver) echo "${DOC_LOC:+$((DOC_LOC*3))}";; *) echo "${DOC_LOC:-}";; esac; }
# FILE budget, per-role for the same reason and proven separately: a flat 15 tripped a test-author at
# `27 files / 461 code lines`. The LINE budget was fine; the FILE count fired, on the one job that is
# inherently wide — threading a newly-mandatory parameter through 49 call sites across 19 test files.
# That cannot be done in 15 files, so the breaker was measuring the shape of a migration the plan
# itself asked for rather than a runaway role. 40 covers a wide legitimate migration with headroom;
# other roles keep CHURN_FILES, which no implementer commit in the measured milestone came near.
churn_files_budget(){ case "$1" in test-author) echo 40;; *) echo "$CHURN_FILES";; esac; }
# COVERAGE_DROP_TOLERANCE_PCT (R5's coverage clause) and FLAKE_RERUN_COUNT (R10) were declared here
# for two years and read by nothing — see lib/knobs.manifest, which now lists every knob with its
# reader and is asserted by the self-check. They are gone from the template rather than kept as an
# honestly-labelled exclusion; a repo that carries them in its loop.config loses nothing.
# R13 — SPEND. Every other breaker counts iterations, lines, files or rounds. The ledger has recorded
# seconds, tokens and dollars for every role run since it existed, and nothing read them — so a
# milestone can stay inside every breaker while quadrupling its cost. Measured: one walking-skeleton
# milestone (6 planned steps) spent $60.45 over 36 role invocations, 82.6M tokens, and tripped
# nothing; its most expensive single invocation was 12.6M tokens and $3.86.
#
# MILESTONE_USD_CEILING is UNSET by default, and that is deliberate: a dollar ceiling is a property of
# the PLAN, not of the harness — a scaffold milestone and a redaction milestone do not deserve the
# same number. TDD_PLAN §2 should carry one per milestone the way iteration_budget() does. Unset =
# off, exactly like DOC_LOC.
# The brief pastes the committed diff since the last journalled iteration when it is at most this many
# lines, and degrades to `git diff --stat` plus the command when it is larger. A patch under the cap is
# cheaper pasted than fetched (the role would spend a turn on it either way); a 4,000-line patch pasted
# into every brief moves the cost rather than removing it.
BRIEF_DIFF_MAX=400
# At most this many `[YOURS]` findings in one writing-role brief; the rest are counted, stay open in
# issues.md, and reach the role's next invocation after the review at HEAD. A seven-item brief overran
# the 10 M token budget twice and landed a subset each time (TT-4348 M7); four is what one invocation
# lands. 0 = no cap.
BRIEF_FINDINGS_CAP=4

MILESTONE_USD_CEILING=
# Per-milestone, and preferred over the scalar above when defined — same shape as iteration_budget(),
# same source (TDD_PLAN §2). Size it from the milestone's own budget and tier, not from the last
# milestone's bill: roughly 3x the iteration budget for routine work, 4x where every role runs at the
# strongest tier. A milestone with no case here falls back to the scalar.
#
# AND SIZE IT FOR THE REVIEW SIDE, NOT THE BUILD PHASE: one review round is REVIEW_DIMENSIONS
# reviewers at MODEL_REVIEWER, ~$15 each at the full tier by the driver's own projection, and the
# driver checks the ceiling between spawns - a ceiling below one fan-out forces the round sequential
# and can stop it mid-round (TT-4348 M5: four steps built for $6.78, ceiling $35, raised to $70 for
# the review). Floor: build phase + 2 x (dimensions x full-tier reviewer) + the verify passes. The
# number `run` prints in its first line is the one it holds; an edit while it runs needs a relaunch.
#
# milestone_usd_ceiling(){ case "$1" in
#   M0) echo 15;;              # generated, not looped
#   M1|M3) echo 50;;           # correctness_critical: opus throughout
#   *) echo 30;; esac; }

# The per-INVOCATION token ceiling, on the other hand, ships armed and generous: it exists to catch a
# role that has stopped converging and is re-reading the world, not to second-guess a big legitimate
# step. 10M is roughly 3x the measured implementer average and comfortably above the worst honest run
# seen so far. Lower it once briefs are prepared (a role handed a diff and its own findings should not
# need millions of tokens to start). A role with no case falls back to TOKEN_BUDGET_DEFAULT; empty
# means no ceiling for that role.
# ...PER STEP WHEN THE PLAN DECLARES ONE (harness 1.8.8): `$2` is the TDD_PLAN step id the brief
# named (empty post-review), so a step the plan knows is large - an opening step that wires an
# aggregate, a step that touches two thirds of the milestone's classes - can carry its own ceiling
# instead of tripping R13-LANDED on a budget sized for the average (TT-4348 M11 §2.5: 12.0 M and
# 12.9 M on step 6, a stop at 10.05 M on step 7). Price the step, do not raise the default: the
# default is what catches a role re-reading the repository.
#   token_budget(){ case "$1:${2:-}" in implementer:6|test-author:6) echo 15000000;; *) ...;; esac; }
# (`${2:-}`, not `$2`: the driver runs under `set -u`, and a one-argument call - any reader from
# before 1.8.8 - would otherwise abort the function and price the role as unbudgeted.)
TOKEN_BUDGET_DEFAULT=10000000
token_budget(){ case "$1" in test-author|implementer|reviewer) echo "$TOKEN_BUDGET_DEFAULT";; *) echo "";; esac; }
# The PRE-HOC arm of the same ceiling: `spawn` passes `--max-budget-usd` to the CLI, so an invocation
# that is re-reading the world is cut off while it happens, not diagnosed from the ledger after it
# has spent. Empty = derived: token_budget(role, step) × a per-model $/token estimate (opus 0.75, sonnet
# 0.30, haiku 0.15 per million — cache reads dominate a role's bill) × 2 for headroom. 0 = off. Set a
# number to override for every role. A role that is cut off has not journalled, so the brief for the
# next invocation of that role says so under "Your previous attempt".
SPAWN_USD_CAP=

# R11 budget counts review ROUNDS, not reviewers: one fan-out of N dimension reviewers = ONE round.
REVIEW_BUDGET=3
# RO (1.8.8): a reviewer that answers `blocked` with no findings is an `owed` row and its dimension is
# re-run at the same round; this many owed rows within one round's reviewer run stop the run - a reviewer that
# stops twice is a role or environment failure to fix by hand, not a round to pay for again.
REVIEW_OWED_LIMIT=2
# Past this round a review lane stops being allowed to spend rounds on its own PAPERWORK. A defect in
# a document (docs/, specs/, any bare *.md) is recorded as ONE line under a `## Deferred to ticket`
# heading and is not a blocker or major, so it cannot hold the gate or buy another round; a defect in
# something EXECUTABLE still is. Two readers: the reviewer brief prints the cap from this round on,
# and `consolidate` refuses a doc-only blocker/major raised past it, naming the finding.
#
# Measured on the loop this came from: ONE milestone spent six of its seventeen rounds on findings
# whose only cited paths were documents. A review lane that keeps finding things in its own prose will
# keep finding them, because prose always has another sentence to fix — and each round is a full
# fan-out at the reviewer tier.
#
# NOT a licence to stop reading documents: a document that CONTRADICTS the code is a finding about
# the code it misdescribes and stays in scope at full severity. The cap is on findings whose ONLY
# evidence is prose. `REVIEW_SRC_ONLY_AFTER_ROUND=99 loop-driver.sh consolidate <MS>` is the escape
# hatch for a milestone whose rounds predate the rule — its evidence is not to be rewritten.
REVIEW_SRC_ONLY_AFTER_ROUND=5
# Per-milestone override, same shape as iteration_budget() and milestone_usd_ceiling(). A milestone
# with no case returns empty and keeps the scalar above, which is the shipped behaviour.
#
# REQUIRED, not optional — harness-selfcheck.sh lists it in REQUIRED_CONFIG_FN and fails without it.
# The comment here said "delete the function entirely and nothing changes" for one release AFTER the
# check that makes that false was written: a config whose own documentation invites the edit that
# breaks the self-check is worse than no documentation. What is optional is the CASE LIST, which is
# empty by default; the function itself has to exist so the knob it resolves has a reader.
#
# Exists because a plan carried `REVIEW_BUDGET_CRITICAL=5` in this file for two whole milestones with
# NO READER ANYWHERE — its TDD_PLAN granted the mutation-gated milestones five rounds (each round's
# fixes re-proven by execution before the next starts) and the driver gave them three, silently. Read
# membership from a list you already keep, so the two cannot drift.
#
# DEFINED, not commented out. Shipping it as a comment is how COVERAGE_TARGET_PCT stayed unread
# through the very PR that "gave it a reader": the reader existed in gate.sh and the function it
# looked for was never defined on a fresh install, so the knob was exactly as dead as before and the
# self-check said otherwise.
REVIEW_BUDGET_CRITICAL=5
review_budget(){ case " ${CORRECTNESS_CRITICAL:-} " in
  *" $1 "*) echo "${REVIEW_BUDGET_CRITICAL:-$REVIEW_BUDGET}";;
  *)        echo "";;
esac; }
# How far back the review window falls when the branch has NO distinct base — the loop running on its
# own base branch, or a repo with no remote. fork_point() has no merge-base to find there, and its
# previous answer was the root commit: the whole history as the round-1 diff and as R8's churn
# baseline. Bounded here instead. Only this degenerate case reads it; a normal loop branch never does.
REVIEW_FALLBACK_COMMITS=200
# Dimensions fanned out per round (newline-delimited; each gets its own cold reviewer + own file).
# READ BY loop-driver.sh's `run`: a reviewer round spawns one reviewer PER ENTRY, each told to review
# that dimension and nothing else, each probing in its own `review-workspace.sh path <dim>` worktree,
# each writing `review-results/<branch>_<ms>_round<N>_<dim>_issues.md`. `consolidate` merges them; the
# R11 budget counts the fan-out as ONE round, which is what it has always said it counted. The
# MILESTONE is in that filename because `review_rounds()` and `consolidate` both select a milestone's
# artifacts by grepping its id against the FILENAME — without it the whole feature worked only on a
# branch whose name happened to contain the milestone.
#
# The width is a COST MULTIPLIER on every review round — three dimensions is three invocations — and
# it scales the RI cap with it, up from the pre-fan-out 2x review budget and never below it. EMPTY is
# supported and means one unnamed reviewer covering everything, at exactly the cap it had before this
# knob was read — which is what this harness actually did for its whole history.
REVIEW_DIMENSIONS='correctness
conformance
crossartifact'
# ── review economics (harness 1.8.0) ──────────────────────────────────────
# Round 1 is always a full fan-out. From round 2 on, `run` measures the diff in MAIN_SCOPE + TEST_SCOPE
# since the HEAD the last full round reviewed: over REVIEW_FULL_ROUND_DIFF_LINES it fans out again;
# under it, ONE verifier (MODEL_VERIFIER) re-proves the open findings by id; EMPTY, nothing is spawned
# and the run stops (RU) — a re-review of an unchanged tree cannot close anything. Measured reason:
# one milestone's rounds 5-8 were full fan-outs at $2.70-$3.70 each that produced one major between
# them, every one re-reading a diff a previous round had read the front of. 0 restores full fan-outs
# on every round; ABSENT (a config from before 1.8.0) is also off, so an upgrade changes nothing
# until this line is added.
REVIEW_VERIFY_MODE=1
REVIEW_FULL_ROUND_DIFF_LINES=200
# 1 runs the dimensions of a round CONCURRENTLY — one process each, own brief, own result file, rows
# appended in dimension order after the last one exits — so the round's wall clock is the slowest
# dimension, not their sum. 0 (and ABSENT) is the sequential fan-out. The one thing sequential buys is
# the cost breakers re-checked BETWEEN dimensions: a parallel round can overshoot MILESTONE_USD_CEILING
# by up to width-1 invocations, so `run` falls back to sequential for a round whose projected spend
# (width x the milestone's mean reviewer cost) would cross the ceiling, and says so.
REVIEW_PARALLEL=1
# RA — AREA RECURRENCE. This many blocker/major findings raised against ONE path across AT LEAST TWO
# rounds since the last ack (open or resolved; refuted ones do not count — and three dimensions naming
# one path in one round is one defect seen from three angles, not a recurrence) stops the run with every finding
# on that path in ESCALATION.md: fix the abstraction, not the case. Measured: four review rounds
# produced four patches to one mechanism, each closing the shape just reported and revealing the next,
# at a round's cost each; a human reading the four findings together fixed the class in one commit.
AREA_RECURRENCE_LIMIT=3
COVERAGE_FLOOR_PCT=80; COVERAGE_TARGET_PCT=85; MUTATION_FLOOR_PCT=85
# Milestones held to COVERAGE_TARGET_PCT rather than to the floor — the RAMP the plan template
# declares as `coverage_line_pct: 70  # floor; ramp to 80; never lower`. Same shape as
# CORRECTNESS_CRITICAL above and for the same reason: which milestones have ramped is a decision the
# PLAN carries and this file transcribes, so the harness never raises a gate the plan did not ask for.
COVERAGE_TARGET_MILESTONES='M1 M2 M3 M4'         # e.g. 'M1 M2 M3'
# The per-milestone coverage floor, DEFINED rather than commented out. Shipping it as a comment is
# how COVERAGE_TARGET_PCT stayed unread through the very PR that "gave it a reader": gate.sh resolved
# through a function no fresh install defined, so the knob was exactly as dead as before and the
# self-check said otherwise.
#
# BOTH thresholds are read here, which is the whole point of the selector. Answering
# COVERAGE_TARGET_PCT for every non-M0 milestone — the first version of this fix — killed
# COVERAGE_FLOOR_PCT instead: gate.sh's `[ -n "$f" ] ||` fallback and the `${COVERAGE_TARGET_PCT:-}`
# default are both unreachable once this function always answers, so one dead knob was traded for
# another AND every existing project's gate moved 70 -> 80 without a line saying so.
#
# M0's exemption belongs here rather than hard-coded in gate.sh: a scaffold milestone has almost no
# logic to cover, and that is a decision the PLAN should carry, not the harness.
coverage_floor(){ case "$1" in
  M0) echo 80;;
  *)  case " ${COVERAGE_TARGET_MILESTONES:-} " in
        *" $1 "*) echo "${COVERAGE_TARGET_PCT:-$COVERAGE_FLOOR_PCT}";;
        *)        echo "$COVERAGE_FLOOR_PCT";;
      esac;;
esac; }

# Mutation tier scope — what the adapter's `gate_mutation` measures against MUTATION_FLOOR_PCT above.
# EMPTY (the default) → the tier reports SKIP: nothing is declared, so no measurement is owed. It is
# never PASS, and MUTATION_FLOOR_PCT alone has never meant anything — it sat here with no consumer at
# all until the tier got an executor, and two milestones of one driven loop recorded gate PASS naming
# a mutation score that nothing had computed.
#
# Declared HERE, as a list, because a scope buried in a command line is a scope nobody reviews:
# "mutation 94%" means nothing until you can see which statements it is 94% of. Keep it SMALL and
# keep it to the correctness CORES — pure decisions, no clock, no config, no adapter. Over wiring
# code most mutants are unreachable or equivalent and the number stops meaning anything; mutating all
# of src/ is not a stricter version of this gate, it is an intractable different one.
#
# The list GROWS at each milestone close-out and never ROTATES: a scope that moved with the milestone
# would unmeasure the previous one the day the next arrived — one loop reported `mutation 99%` for a
# whole milestone that was measured entirely over the PREVIOUS milestone's three modules.
#
# pytest/mutmut: the same list must also be `[tool.mutmut] only_mutate` in pyproject.toml (mutmut has
# no CLI equivalent). The adapter CROSS-CHECKS the two and refuses to score while they disagree — a
# second hand-maintained copy of one set is a drift the gate would otherwise report as a percentage.
MUTATION_TARGETS=''

# Integration-tier parallelism (adapters that implement `it_parallel_args`). Container-backed
# integration suites are usually IO-BOUND, not CPU-bound: one measured suite ran 375 Testcontainers
# tests in 7:27 at 6% CPU — waiting on empty consumer polls and broker rebalances — and 3:36 at
# `-n 4 --dist loadfile`, same tests, same coverage figure.
#
# Default 1 (serial, unchanged) because parallel-safety is a property of YOUR fixtures, not of the
# harness. Raise it only once you know they hold. Two things to know before you do:
#   * `--dist loadfile` is load-bearing where fixtures are session-scoped: each xdist worker gets its
#     OWN session, so grouping by file keeps a module's containers on one worker instead of every
#     worker starting every container type.
#   * The worker count is therefore a CONTAINER MULTIPLIER, not just a CPU count — `auto` on a
#     14-core machine can mean fourteen full container sets.
# Do NOT extend this to the unit tier: measured on a 2696-test pure suite, serial 8.8s beat `-n 4`
# at 10.3s and `-n auto` at 12.0s. A fast suite cannot amortise worker startup.
IT_PARALLEL_WORKERS=1

# R1 per-milestone iteration budgets — TDD_PLAN §2 (hardest milestone gets the most).
# M0 is 4 because it is GENERATED, not looped (plan recipe, milestone-rules.md): scaffold, gate, one
# review round, one fix round. A loop that plans M0 as six RED→GREEN steps will ask for more, and the
# answer is to re-plan the milestone rather than raise the number — the measured M0 that did the
# latter ran 19 iterations and $60.45 for a walking skeleton.
iteration_budget() { case "$1" in
  M0) echo 6;; M1) echo 26;; M2) echo 24;; M3) echo 24;; M4) echo 14;; *) echo 6;; esac; }

# Reasoning effort per role — passed as the Agent spawn's effort override, orthogonal to the model.
# ids: low|medium|high|xhigh|max. Code-writing and reviewing roles stay high: loop cost is recovered
# from the gate tiers, warm caches and concurrent review, not from thinking less about the change.
# Escalation above these tiers is a separate concern (TT-3176), deliberately not modelled here.
EFFORT_TEST_AUTHOR="${KITCHEN_EFFORT_TEST_AUTHOR:-high}"
EFFORT_IMPLEMENTER="${KITCHEN_EFFORT_IMPLEMENTER:-high}"
EFFORT_REVIEWER="${KITCHEN_EFFORT_REVIEWER:-high}"     # never lower: the independent gate
EFFORT_VERIFIER="${KITCHEN_EFFORT_VERIFIER:-medium}"   # re-proves named findings by execution; reads commits, not the milestone
EFFORT_SCAFFOLD="${KITCHEN_EFFORT_SCAFFOLD:-medium}"   # M0 layout generation
EFFORT_JIRA_OPS="${KITCHEN_EFFORT_JIRA_OPS:-low}"      # ticket reads/transitions
EFFORT_SEARCH="${KITCHEN_EFFORT_SEARCH:-low}"          # read-only exploration/fan-out

# Per-milestone/per-STEP implementer model — same shape as iteration_budget(), same source
# (TDD_PLAN §2/§8). Correctness-critical work (crypto, concurrency, money, ordering) → opus. Routine
# work (CRUD, DTO, config, M0 scaffold) → sonnet. The driver passes the result as the implementer
# spawn's model override. Reviewer and gates are unaffected — cheaper implementer, same acceptance bar.
#
#   milestone_model <Mn> [<step>]
#
# The STEP is PASSED (`loop-driver.sh ... --step 3c`), never derived. Deriving it was the first design
# and it does not work: the only counter the driver has is the implementer invocation count, and one
# measured milestone spent SEVEN implementer invocations on FOUR steps — retries, a re-run after an
# R6, a fix round. Step 4's model would have been chosen for step 7.
#
# NO STEP → THE SAFE MODEL, never the cheap one. That asymmetry is the whole safety property:
# forgetting `--step` costs money and can never cost correctness. Do not add a `*)` arm that
# downgrades an unrecognised step for the same reason — an id that has been renamed in TDD_PLAN §5
# must fall back UP, not down.
#
# AN EXPLICIT PER-STEP ARM WINS OVER THE MUTATION ESCALATION (harness 1.8.5). On a milestone in
# CORRECTNESS_CRITICAL the driver raises the implementer to MODEL_ESCALATION_MUTATION - UNLESS this
# function has an arm for exactly that step (`M8:7|M8:8`): then the arm's tier is what the step runs
# at, because the plan author looked at the step and priced it. The escalation covers the steps the
# author did not price: the `*)` fallback and a milestone-wide `Mn:*` arm are NOT per-step hints and
# keep the escalation (measured on TT-4348 M8: `M8:7|M8:8 -> sonnet` lost to the escalation, $6.38 on
# opus, and the hint was dead text). The driver tells the two apart by asking this function for a
# step id no plan carries (`no-such-step`) on the same milestone: a different answer means an arm
# matched the step. The reviewer and the verifier escalate regardless - no step hint prices the last
# gate. The run header prints `STEP HINT` where it prints `ESCALATED`.
milestone_model() { local ms step; ms="$1"; step="${2:-}"
  [ -n "$step" ] || { echo "$MODEL_IMPLEMENTER"; return; }   # unset --step → SAFE
  case "$ms:$step" in
    M0:*)              echo "${MODEL_IMPLEMENTER_ROUTINE:-sonnet}";;  # skeleton generation
    M4:*)              echo "${MODEL_IMPLEMENTER_ROUTINE:-sonnet}";;  # card YAML + jinja
    M1:*|M2:*|M3:*)    echo "$MODEL_IMPLEMENTER";;                    # correctness-critical milestones
    *)                 echo "$MODEL_IMPLEMENTER";;                    # unknown step → SAFE
  esac; }

# Heartbeat interval, in seconds, for a role the driver is waiting on. 0 disables it.
# A role emits NOTHING until it exits, so a 99-minute invocation and a hung one look identical from
# outside — that is how four invocations were killed mid-flight in one measured milestone, two of them
# AFTER committing but BEFORE their gate, leaving ungated commits and missing ledger rows to repair by
# hand. The heartbeat is deliberately NOT `--output-format stream-json`: that would trade the parseable
# `total_cost_usd`/`usage` record the ledger is built on for a cosmetic one.
HEARTBEAT_SECS="${HEARTBEAT_SECS:-60}"
# How often the driver checks whether a spawned role has exited (seconds; fractions allowed). 1 is
# invisible on a role that runs minutes; the fixture suite sets 0.1 because its roles are stubs that
# exit at once, and a 2 s poll was 16 % of its wall clock (20.7 -> 17.4 min, 1.8.7).
SPAWN_POLL_SECS="${SPAWN_POLL_SECS:-1}"

# 1 (default) makes `loop-driver.sh run` recompute scripts/HARNESS_SHA before spending and refuse on
# a mismatch — two worktrees of one repo ran drivers 248 lines apart under one version string. 0
# disables it; a scripts/.upstream-exempt manifest also skips it, because declared local edits are
# exactly what the hash would catch.
HARNESS_SHA_CHECK="${HARNESS_SHA_CHECK:-1}"   # env wins (1.8.7 review): `HARNESS_SHA_CHECK=0 run` was dead against a bare =1
